# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Cloud Vision (optional - for receipt OCR)
GOOGLE_CLOUD_VISION_API_KEY=your-google-cloud-vision-api-key

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=ZZP Platform <noreply@zzpplatform.nl>

# KVK (Kamer van Koophandel) - optioneel, zonder key wordt de testomgeving gebruikt
KVK_API_KEY=your-kvk-api-key

# GoCardless (SEPA Automatische Incasso - optioneel)
GOCARDLESS_ACCESS_TOKEN=your-access-token
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=your-webhook-secret

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
