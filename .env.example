# ==============================================================================
# ZZP Tax - Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Your Supabase project URL (e.g., https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here

# Supabase anon/public key (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (KEEP SECRET - only for backend/API routes)
# This bypasses Row Level Security - NEVER expose in frontend!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# Google Cloud Vision API (OPTIONAL - for OCR feature)
# ------------------------------------------------------------------------------
# If not set, OCR (receipt scanning) will be disabled
# Users can still manually enter expenses
#
# Get an API key from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Enable the Cloud Vision API
# 3. Create credentials → API key
# 4. Restrict the key to Cloud Vision API for security

GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# ------------------------------------------------------------------------------
# Next.js Configuration (OPTIONAL)
# ------------------------------------------------------------------------------

# Set to 'production' for production deployments
# NODE_ENV=production

# Your production domain (for Open Graph images, absolute URLs, etc.)
# NEXT_PUBLIC_APP_URL=https://yourapp.com

# ------------------------------------------------------------------------------
# Database Setup Instructions
# ------------------------------------------------------------------------------
# After setting up your Supabase project, run the following SQL in the SQL Editor:
#
# 1. Create tables (see /supabase/schema.sql if available, or create manually):
#    - expenses (id, user_id, amount_incl, amount_excl, btw_amount, btw_rate, ...)
#    - btw_reports (id, user_id, year, quarter, total_excl, total_btw, ...)
#    - categories (id, user_id, name, description, ...)
#
# 2. Enable Row Level Security (RLS) on all tables
#
# 3. Create policies to allow users to access only their own data
#
# See README.md for detailed setup instructions
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# GoCardless (OPTIONAL - SEPA Automatische Incasso)
# ------------------------------------------------------------------------------
# GoCardless biedt SEPA Direct Debit betalingen voor terugkerende facturen.
# Registreer op https://manage.gocardless.com/developers
#
# Gebruik 'sandbox' voor testen, 'live' voor productie

GOCARDLESS_ACCESS_TOKEN=your-access-token
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_WEBHOOK_SECRET=your-webhook-secret
